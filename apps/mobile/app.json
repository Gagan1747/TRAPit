{
  "expo": {
    "name": "TRAPit Mobile",
    "slug": "trapit-mobile",
    "scheme": "trapit",
    "version": "1.0.0",
    "icon": "./trapit-logo.jpeg",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "experiments": {
      "typedRoutes": true
    },
    "plugins": [
      "expo-notifications"
    ],
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "icon": "./trapit-logo.jpeg"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./trapit-logo.jpeg",
        "backgroundColor": "#f5eadb"
      }
    }
  }
}